// ---- User ----
enum ProfileRole {
  ADMIN
  USER
}

model User {
  id           String      @id @default(uuid())
  // Public data
  firstName    String
  lastName     String
  avatarUrl    String?
  bio          String?
  location     Location?
  website      String?
  twitter      String?
  github       String?
  linkedin     String?
  email        String      @unique
  passwordHash String
  role         ProfileRole @default(USER)
  // Internal data
  sessions     Session[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
