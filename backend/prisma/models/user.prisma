enum ProfileRole {
  ADMIN
  USER
}

enum PreferredLocale {
  en
  ru
}

model User {
  id                    String               @id @default(uuid())
  // Public data
  firstName             String
  lastName              String
  headline              String?
  avatarUrl             String?
  coverUrl              String?
  bio                   String?
  location              Location?
  website               String?
  twitter               String?
  github                String?
  linkedin              String?
  email                 String               @unique
  passwordHash          String
  role                  ProfileRole          @default(USER)
  preferredLocale       PreferredLocale      @default(en)
  // Post
  posts                 Post[]
  comments              PostComment[]
  likes                 PostLike[]
  // Profile
  experiences           WorkExperience[]
  educations            Education[]
  languages             UserLanguage[]
  skills                UserSkill[]
  // Connections
  sentConnections       Connection[]         @relation("ConnectionRequester")
  receivedConnections   Connection[]         @relation("ConnectionAddressee")
  // Follow (one-way)
  following             Follow[]             @relation("FollowFollower")
  followers             Follow[]             @relation("FollowFollowing")
  // Moderation
  reportsFiled          Report[]
  // Gamification
  gamification          UserGamification?
  pointsTransactions    PointsTransaction[]
  // Jobs
  jobsPosted             Job[]
  // Conversations
  conversations         ConversationMember[]
  messages              Message[]
  devices               UserDevice[]
  messageReactions      MessageReaction[]
  // Engagement
  savedPosts            SavedPost[]
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsActed    Notification[]       @relation("NotificationActor")
  profileViewsMade      ProfileView[]        @relation("ProfileViewsMade")
  profileViewsReceived  ProfileView[]        @relation("ProfileViewsReceived")
  postImpressions       PostImpression[]
  newsStoryReads        NewsStoryRead[]
  // Internal data
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}
