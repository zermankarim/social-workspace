// ---- User ----
enum ProfileRole {
  ADMIN
  USER
}

enum PreferredLocale {
  en
  ru
}

model User {
  id           String        @id @default(uuid())
  // Public data
  firstName    String
  lastName     String
  headline     String?
  avatarUrl    String?
  coverUrl     String?
  bio          String?
  location     Location?
  website      String?
  twitter      String?
  github       String?
  linkedin     String?
  email        String        @unique
  passwordHash String
  role         ProfileRole   @default(USER)
  preferredLocale PreferredLocale @default(en)
  // Post
  posts        Post[]
  comments     PostComment[]
  likes        PostLike[]
  // Profile
  experiences  WorkExperience[]
  educations   Education[]
  languages    UserLanguage[]
  skills       UserSkill[]
  // Internal data
  sessions     Session[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
