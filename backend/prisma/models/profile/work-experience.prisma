enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  FREELANCE
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  SEASONAL
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

model WorkExperience {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  employmentType EmploymentType
  companyName    String
  /// Set only when the employer is a registered Company page (picked from
  /// autocomplete); free-typed employer names leave this null.
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  workplaceType  WorkplaceType
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([companyId])
}
