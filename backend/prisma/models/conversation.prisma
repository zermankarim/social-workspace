model Conversation {
  id        String   @id @default(uuid())
  // Sorted "userAId_userBId" — one DIRECT chat per pair
  directKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderDeviceId String?
  senderDevice   UserDevice?  @relation(fields: [senderDeviceId], references: [id], onDelete: SetNull)

  /// Legacy single-target payload (base64). Null on messages created after the
  /// per-device fan-out migration — those live entirely in `recipientKeys`.
  ciphertext String?
  nonce      String?
  keyVersion Int      @default(1)

  /// One encrypted copy per target device (every device of both conversation
  /// members), so any of them can decrypt regardless of who was online at send time.
  recipientKeys MessageRecipientKey[]
  attachments   MessageAttachment[]
  reactions     MessageReaction[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([senderDeviceId])
}

/// Per-device fan-out of a message's encrypted payload — one row per target
/// UserDevice (all of the recipient's devices + all of the sender's own other
/// devices), so multi-device users can always decrypt regardless of which
/// device was "most recently seen" at send time.
model MessageRecipientKey {
  id         String     @id @default(uuid())
  messageId  String
  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId   String
  device     UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ciphertext String
  nonce      String
  keyVersion Int        @default(1)
  createdAt  DateTime   @default(now())

  @@unique([messageId, deviceId])
  @@index([deviceId])
}

model MessageAttachment {
  id             String   @id @default(uuid())
  messageId      String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url            String
  /// Optional separate encryption for the blob (if not using conversation session key alone)
  ciphertextSize Int?
  createdAt      DateTime @default(now())

  @@index([messageId])
}

/// Public keys only. Private keys never leave the device.
model UserDevice {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String
  identityKeyPub  String
  signedPreKeyPub String
  signedPreKeyId  Int
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  messages        Message[]
  recipientKeys   MessageRecipientKey[]

  @@unique([userId, deviceId])
  @@index([userId])
}
