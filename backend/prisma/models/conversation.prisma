model Conversation {
  id        String   @id @default(uuid())
  // Sorted "userAId_userBId" — one DIRECT chat per pair
  directKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderDeviceId String?
  senderDevice   UserDevice?  @relation(fields: [senderDeviceId], references: [id], onDelete: SetNull)

  /// Encrypted payload (e.g. JSON: { text, attachmentMeta[] }) base64
  ciphertext String
  nonce      String
  keyVersion Int    @default(1)

  attachments MessageAttachment[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([senderDeviceId])
}

model MessageAttachment {
  id             String   @id @default(uuid())
  messageId      String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url            String
  /// Optional separate encryption for the blob (if not using conversation session key alone)
  ciphertextSize Int?
  createdAt      DateTime @default(now())

  @@index([messageId])
}

/// Public keys only. Private keys never leave the device.
model UserDevice {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String
  identityKeyPub  String
  signedPreKeyPub String
  signedPreKeyId  Int
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  messages        Message[]

  @@unique([userId, deviceId])
  @@index([userId])
}
