enum PostStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
}

model Post {
  id           String           @id @default(uuid())
  textContent  String?
  authorId     String
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status       PostStatus       @default(PUBLISHED)
  /// Only meaningful when status is SCHEDULED — when the post auto-publishes.
  scheduledFor DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  comments     PostComment[]
  attachments  PostAttachment[]
  postLikes    PostLike[]

  // Repost / quote: a repost is a Post pointing to the original via repostOfId.
  repostOfId String?
  repostOf   Post?   @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts    Post[]  @relation("PostReposts")

  hashtags      Hashtag[]
  savedBy       SavedPost[]
  notifications Notification[]
  impressions   PostImpression[]

  likesCount       Int @default(0)
  commentsCount    Int @default(0)
  repostsCount     Int @default(0)
  impressionsCount Int @default(0)

  @@index([authorId])
  @@index([authorId, status])
  @@index([status, scheduledFor])
  @@index([createdAt])
  @@index([repostOfId])
}

model PostAttachment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([postId])
}
