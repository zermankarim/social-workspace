model PostComment {
  id          String                  @id @default(uuid())
  textContent String?
  authorId    String
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post        Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  /// One level of nesting only: a reply's parent must itself be a top-level comment (enforced in the service).
  parentId    String?
  parent      PostComment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PostComment[]           @relation("CommentReplies")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  attachments PostCommentAttachment[]

  @@index([authorId])
  @@index([postId])
  @@index([createdAt])
  @@index([parentId])
}

model PostCommentAttachment {
  id        String      @id @default(uuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime    @default(now())

  @@index([commentId])
}
